{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@praxis-ai/praxis": ["src/agentCore/index.ts"],
      "@praxis-ai/praxis/agent-core": ["src/agentCore/index.ts"],
      "@praxis-ai/praxis/application-layer": ["src/applicationLayer/index.ts"],
      "@praxis-ai/praxis/rax": ["src/rax_packageManager/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "test/agentCore/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
