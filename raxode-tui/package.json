{
  "name": "@praxis-ai/raxode",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Raxode coding agent backend and Raxode TUI built on Praxis.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/raxode",
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "raxode": "./bin/raxode"
  },
  "exports": {
    ".": {
      "types": "./dist/raxode-cli/index.d.ts",
      "import": "./dist/raxode-cli/index.js"
    },
    "./backend": {
      "types": "./dist/raxode-cli/backend/raxodeBackend.d.ts",
      "import": "./dist/raxode-cli/backend/raxodeBackend.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "clean": "node automations/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json && node automations/copy-dist-assets.mjs",
    "gui:dev": "vite --config raxode-cli/frontend/gui/vite.config.ts",
    "gui:build": "vite build --config raxode-cli/frontend/gui/vite.config.ts",
    "gui:electron": "electron raxode-cli/frontend/gui/electron/main.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:dry": "npm pack --dry-run --json",
    "test": "npm run test:application",
    "test:unit": "npm run test:application",
    "test:application": "node --import tsx --test raxode-cli/frontend/bridge/*.test.ts raxode-cli/frontend/tui/cli/*.test.ts raxode-cli/frontend/tui/input/*.test.ts raxode-cli/backend/tests/*.test.ts",
    "test:all": "find raxode-cli -type f -name '*.test.ts' -print0 | xargs -0 node --import tsx --test",
    "raxode:raxode-tui": "RAXODE_RENDER_FPS=120 RAXODE_STREAM_FPS=120 node --import tsx raxode-cli/frontend/tui/app/direct-tui.tsx",
    "raxode:cache-xray": "node automations/raxode-cache-xray.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.138",
    "@anthropic-ai/sdk": "^0.78.0",
    "@google/adk": "^0.5.0",
    "@google/genai": "^1.52.0",
    "@lancedb/lancedb": "^0.27.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/agents": "^0.11.4",
    "@praxis-ai/praxis": "0.1.1",
    "@praxis-ai/raxcell": "^0.1.4",
    "apache-arrow": "^18.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ink": "^5.2.1",
    "lucide-react": "^1.16.0",
    "node-pty": "^1.1.0",
    "openai": "^6.37.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "string-width": "^7.2.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "electron": "^42.2.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.13"
  }
}
