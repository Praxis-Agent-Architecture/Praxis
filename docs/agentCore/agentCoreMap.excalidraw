      "isDeleted": false,
      "boundElements": [],
      "updated": 1776919567151,
      "link": null,
      "locked": false,
      "text": "按“测试者 -> 管理会话 -> 管理控制台 -> 命令路由 -> 行为事件 -> 日志文件”的顺序读。这个链路决定后续重塑功能时能不能复盘。",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "按“测试者 -> 管理会话 -> 管理控制台 -> 命令路由 -> 行为事件 -> 日志文件”的顺序读。这个链路决定后续重塑功能时能不能复盘。",
      "lineHeight": 1.2,
      "index": "b29",
      "autoResize": true
    },
