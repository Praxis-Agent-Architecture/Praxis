      "versionNonce": 1016283815,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776919567150,
      "link": null,
      "locked": false,
      "text": "按“材料 -> 输入包 -> lowering -> 内部模型能力 -> 跨厂商抽象 -> 真实 provider”的顺序读。重点是不被 OpenAI/Claude/Gemini 任意一家接口形状绑死。",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "按“材料 -> 输入包 -> lowering -> 内部模型能力 -> 跨厂商抽象 -> 真实 provider”的顺序读。重点是不被 OpenAI/Claude/Gemini 任意一家接口形状绑死。",
      "lineHeight": 1.2,
      "index": "b1W",
      "autoResize": true
    },
