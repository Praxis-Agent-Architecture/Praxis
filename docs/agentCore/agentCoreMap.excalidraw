    {
      "id": "txt_51",
      "type": "text",
      "x": 90,
      "y": 720,
      "width": 969.3118896484375,
      "height": 43.199999999999996,
      "angle": 0,
      "strokeColor": "#0f172a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
