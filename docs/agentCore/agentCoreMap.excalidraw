      "text": "4. 模型调用链：PromptPack 如何走到 Provider",
      "fontSize": 34,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. 模型调用链：PromptPack 如何走到 Provider",
      "lineHeight": 1.2,
      "index": "b1V",
      "autoResize": true
    },
    {
      "id": "append345_txt_1776918914801_49",
      "type": "text",
      "x": 2265.421875,
      "y": 750.765625,
      "width": 2470,
      "height": 120,
      "angle": 0,
      "strokeColor": "#9ca3af",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 96319484,
