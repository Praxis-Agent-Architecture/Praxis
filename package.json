{
  "name": "@praxis-ai/praxis",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Praxis agentCore architecture scaffold, tests, and engineering contracts.",
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "rax": "./bin/rax",
    "praxis-raxode": "./raxode-tui/bin/raxode"
  },
  "exports": {
    ".": "./src/agentCore/index.ts",
    "./agentCore": "./src/agentCore/index.ts",
    "./agent-core": "./src/agentCore/index.ts",
    "./application": "./src/applicationLayer/index.ts",
    "./application-layer": "./src/applicationLayer/index.ts",
    "./basetool": "./src/basetool/index.ts",
    "./modelAdapter/*": "./src/modelAdapter/*",
    "./model-adapter/*": "./src/modelAdapter/*",
    "./provider/*": "./src/modelAdapter/*",
    "./memory": "./src/memory_managementPool/index.ts",
    "./modelAdapter": "./src/modelAdapter/index.ts",
    "./model-adapter": "./src/modelAdapter/index.ts",
    "./rax": "./src/rax_packageManager/index.ts",
    "./raxode": "./raxode-tui/raxode-cli/index.ts",
    "./raxode/backend": "./raxode-tui/raxode-cli/backend/raxodeBackend.ts",
    "./raxode/contracts": "./raxode-tui/raxode-cli/contracts.ts"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "raxode-tui",
    "!examples/scripts/agentcore_chat.ts",
    "!examples/scripts/agentcore_tool_lab.ts",
    "!examples/scripts/agentcore_all_tools_matrix.ts",
    "!examples/scripts/agentcore_*_live_matrix.ts",
    "!examples/scripts/agentcore_mcp_external_transport_smoke.ts",
    "!examples/scripts/shellFullCapabilities.ts",
    "!src/executionEngine/basic_toolLayer",
    "!src/executionEngine/basic_toolLayer/**",
    "!src/storagePool/baseToolStorage",
    "!src/storagePool/baseToolStorage/**",
    "!src/toolabilityPool",
    "!src/toolabilityPool/**",
    "!src/storagePool/tap_storagePool",
    "!src/storagePool/tap_storagePool/**",
    "LICENSE",
    "tsconfig.json",
    "!**/memory/generated",
    "!**/memory/generated/**",
    "!**/node_modules",
    "!**/node_modules/**",
    "!**/.devdoctor",
    "!**/.devdoctor/**",
    "!**/.raxode",
    "!**/.raxode/**",
    "!**/reports",
    "!**/reports/**",
    "!**/tests",
    "!**/tests/**",
    "!**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "npm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:dry-run": "npm pack --dry-run --json",
    "pack:dist": "mkdir -p dist && npm pack --pack-destination dist",
    "example:minimal": "node --import tsx examples/minimal/runRepoInspector.ts",
    "example:fullstack": "node --import tsx examples/fullstack/runRepoInspector.ts",
    "smoke:agentCore": "node --import tsx examples/scripts/agentcore_smoke.ts",
    "smoke:modelAdapter": "node --import tsx examples/scripts/modelAdapter_smoke.ts",
    "raxode:typecheck": "tsc -p raxode-tui/tsconfig.json --noEmit",
    "raxode:test:backend": "cd raxode-tui && node --import tsx --test raxode-cli/frontend/bridge/*.test.ts raxode-cli/frontend/tui/cli/*.test.ts raxode-cli/frontend/tui/input/*.test.ts raxode-cli/backend/tests/*.test.ts",
    "raxode:test:application": "npm run raxode:test:backend",
    "test:agentCore:live": "AGENTCORE_LIVE_TEST=1 node --import tsx --test test/agentCore/agentCoreLiveSmoke.test.ts",
    "test:agentCore": "find test/agentCore \\( -path test/agentCore/agent_executionEngine/basic_toolLayer \\) -prune -o -type f -name '*.test.ts' -print0 | xargs -0 node --import tsx --test",
    "test:unit": "npm run test:agentCore"
  },
  "devDependencies": {
    "@types/node": "^22.19.19"
  },
  "optionalDependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/transformers": "^4.2.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.138",
    "@anthropic-ai/sdk": "^0.78.0",
    "@google/adk": "^0.5.0",
    "@google/genai": "^1.52.0",
    "@lancedb/lancedb": "^0.27.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/agents": "^0.7.2",
    "@types/react": "^18.3.28",
    "apache-arrow": "^18.1.0",
    "effect": "^3.21.2",
    "ink": "^5.2.1",
    "openai": "^6.37.0",
    "react": "^18.3.1",
    "string-width": "^7.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
